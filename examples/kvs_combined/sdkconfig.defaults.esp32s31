CONFIG_IDF_EXPERIMENTAL_FEATURES=y

#
# Serial flasher config
#
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.8mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.8mb.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

#
# ESP System Settings
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

#
# ESP NETIF Adapter
#
CONFIG_ESP_NETIF_IP_LOST_TIMER_INTERVAL=120
CONFIG_ESP_NETIF_TCPIP_LWIP=y
# CONFIG_ESP_NETIF_LOOPBACK is not set
CONFIG_ESP_NETIF_USES_TCPIP_WITH_BSD_API=y

#
# ESP PSRAM
#
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_SPEED=200
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=n

CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

#
# Cache config
#
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_SIZE=0x20000
CONFIG_CACHE_L2_CACHE_LINE_64B=y
CONFIG_CACHE_L2_CACHE_LINE_SIZE=64
CONFIG_CACHE_L1_CACHE_LINE_SIZE=64

#
# Wi-Fi
#
# Static RX buffers and the cache/management pools are DMA-capable internal RAM,
# the same pool the hardware SHA PSA driver and the Wi-Fi management path draw from
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=80
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6

# S31 has WIFI
CONFIG_ESP_HOSTED_ENABLED=n

#
# SDIO - only consulted if a co-processor build is re-enabled above.
#
#CONFIG_ESP_SDIO_OPTIMIZATION_RX_NONE=y
#CONFIG_ESP_SDIO_OPTIMIZATION_RX_MAX_SIZE=y
#CONFIG_ESP_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_SDIO_CLOCK_FREQ=40000
#CONFIG_ESP_SDIO_CHECKSUM=y
CONFIG_ESP_PKT_STATS=y

CONFIG_SLAVE_LWIP_ENABLED=n
#CONFIG_LWIP_TCP_LOCAL_PORT_RANGE_START=49152
#CONFIG_LWIP_TCP_LOCAL_PORT_RANGE_END=61439
#CONFIG_LWIP_UDP_LOCAL_PORT_RANGE_START=49152
#CONFIG_LWIP_UDP_LOCAL_PORT_RANGE_END=61439

CONFIG_H2S_WIFI_FLOW_CTRL=n
CONFIG_SDIO_DISABLE_GPIO_BASED_SLAVE_RESET=n

# For V1.0B board
# CONFIG_BSP_BOARD_TYPE_SAMPLE_V10B=y
# CONFIG_ESP_SDIO_PIN_D0=49
# CONFIG_ESP_SDIO_PIN_D1=50

# For V1.2 Board
CONFIG_ESP_SDIO_PIN_D0=14
CONFIG_ESP_SDIO_PIN_D1=15
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y


CONFIG_UVC_CHECK_PAYLOAD_HEADER_EOH=n

CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=y
CONFIG_MEDIA_STREAM_ENABLE_USB_UVC_CAM_SENSOR=y

CONFIG_MEDIA_STREAM_UVC_CAPTURE_WIDTH=1280
CONFIG_MEDIA_STREAM_UVC_CAPTURE_HEIGHT=720

CONFIG_ESP_VIDEO_UVC_H264_BITRATE_BPS=800000
CONFIG_ESP_VIDEO_UVC_H264_IFRAME_PERIOD_MS=1000

#
# Bring-up diagnostics. VERBOSE_DRIVER_LOGS raises the esp_video / usb_uvc /
# uvc-frame / uvc-control tags, and it does nothing at all unless DEBUG
# statements are compiled in - hence LOG_MAXIMUM_LEVEL_DEBUG. The default log
# level stays INFO, so only those tags actually emit. Turn both off once the
# camera streams reliably.
#
# CONFIG_ESP_VIDEO_IF_VERBOSE_DRIVER_LOGS=y
# CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# The S31 has no board of its own. Take esp_bsp_devkit - the one BSP with no target
# dependency - rather than BSP_SELECT_NONE, which makes bsp_selector's CMakeLists
# FATAL_ERROR out. NoGLIB because there is no display, and BSP_ERROR_CHECK off so the
# devkit's init functions return an error instead of aborting: its pin assignments
# default to -1, which is precisely the "this board has no such peripheral" case, and
# it has to be survivable at runtime rather than fatal.
CONFIG_BSP_SELECT_ESP_BSP_DEVKIT=y
CONFIG_BSP_SELECT_GLIB=n
CONFIG_BSP_ERROR_CHECK=n
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
