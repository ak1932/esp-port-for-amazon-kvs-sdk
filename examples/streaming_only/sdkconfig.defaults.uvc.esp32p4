# USB UVC camera instead of the on-board MIPI-CSI sensor.
#
# Mirrors esp_video's own host-side reference config for this board family,
# examples/capture_stream/sdkconfig.ci.esp32p4.only_uvc_video_device: the other
# capture interfaces are turned off explicitly. MIPI-CSI is `default y`, and with
# it enabled the app opens /dev/video0 while the UVC node is /dev/video40.
CONFIG_MEDIA_STREAM_ENABLE_USB_UVC_CAM_SENSOR=y
CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=y

CONFIG_MEDIA_STREAM_ENABLE_MIPI_CSI_CAM_SENSOR=n
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=n

# The CSI *video device* stays compiled even though we capture over UVC: the EV
# board BSP unconditionally builds its own camera init against
# esp_video_init_csi_config_t, a type esp_video only declares when that device is
# enabled. Disabling it breaks the BSP at esp32_p4_function_ev_board.c:1133.
# Selecting the sensor above is what decides the node we open, and the device-path
# chain now puts UVC first, so this only leaves an unused /dev/video0 registered.
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y

# Bring-up visibility: format/framesize enumeration, driver logs and the UVC
# frame_info[] dump are all at DEBUG.
CONFIG_ESP_VIDEO_IF_VERBOSE_DRIVER_LOGS=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
# Raise the runtime default too: MAXIMUM_LEVEL only lifts the ceiling, so the USB
# host/hub attach logs stay hidden at the INFO default.
# CONFIG_LOG_DEFAULT_LEVEL_DEBUG is not set
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# A UVC camera's configuration descriptor enumerates every format / frame size /
# frame interval combination, so it runs well past the 256-byte default and
# enumeration fails with "Configuration descriptor larger than control transfer
# max length" before the device is ever usable.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
