+/**
+ * @brief Ask the camera to emit a key frame now
+ *
+ * Issues the UVC VideoStreaming Generate Key Frame control. Useful when a viewer joins
+ * mid-GOP or after packet loss: without it, recovery is bounded by the camera's own
+ * (often multi-second) key-frame interval.
+ *
+ * @param[in] stream_hdl UVC handle obtained from uvc_host_stream_open()
+ * @return
+ *     - ESP_OK: key frame requested
+ *     - ESP_ERR_INVALID_ARG: invalid handle
+ *     - ESP_ERR_NOT_SUPPORTED / ESP_ERR_INVALID_RESPONSE: camera rejected the control
  */
+/**
+ * @brief Set bitrate and key-frame period on a camera's own H.264 encoder
+ *
+ * Uses the UVC H.264 Extension Unit (GUID A29E7641-DE04-47E3-8B2B-F4341AFF003B). Needed
+ * when passing the camera's H.264 through: otherwise the camera picks its own bitrate and
+ * a multi-second key-frame interval, which a constrained uplink cannot carry and a joining
+ * viewer cannot start decoding.
+ *
+ * The unit is located by its GUID, so no per-camera configuration is needed.
+ *
+ * @param[in] stream_hdl       UVC handle obtained from uvc_host_stream_open()
+ * @param[in] bitrate_bps      Target bitrate, 0 to leave unchanged
+ * @param[in] iframe_period_ms Key-frame period in ms, 0 to leave unchanged
+ * @return ESP_OK if the camera committed the configuration
+ */
+esp_err_t uvc_host_stream_h264_set_rate(uvc_host_stream_hdl_t stream_hdl, uint32_t bitrate_bps,
+                                        uint16_t iframe_period_ms);
+
+esp_err_t uvc_host_stream_request_key_frame(uvc_host_stream_hdl_t stream_hdl);
+
 esp_err_t uvc_host_stream_stop(uvc_host_stream_hdl_t stream_hdl);
 
