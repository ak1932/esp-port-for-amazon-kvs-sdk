--- a/uvc_control.c
+++ b/uvc_control.c
@@ -104,6 +104,439 @@
     return ret;
+}
+
+/* UVC H.264 Extension Unit (GUID A29E7641-DE04-47E3-8B2B-F4341AFF003B), as defined by
+ * the USB Video Class H.264 payload spec and implemented by H.264-capable UVC cameras.
+ * It is the only way to reach the camera's own encoder settings: bitrate and key-frame
+ * period. Without it a camera streams at whatever rate it likes (~3 Mbps measured, at
+ * every resolution) with a multi-second GOP, which no constrained uplink can carry and
+ * no viewer can start decoding. */
+#define UVCX_VIDEO_CONFIG_PROBE   0x01
+#define UVCX_VIDEO_CONFIG_COMMIT  0x02
+#define UVCX_PICTURE_TYPE_CONTROL 0x09
+
+/* bmHints tells the camera which fields the host is asserting and it must therefore keep
+ * fixed; every field NOT hinted is one it is free to trade away to meet the rest.
+ *
+ * These values are not sequential bit positions - they are the specific assignments the
+ * USB Video Class H.264 payload spec makes - and getting one wrong is silent, because a
+ * wrong bit is still a valid hint for some other field. Measured on ESP32-S31 with
+ * FRAME_INTERVAL wrongly defined as 0x0001 (which is RESOLUTION): asking for a pinned
+ * 30 fps hinted resolution, profile and bitrate but not the frame interval, so the frame
+ * interval was precisely the one field the camera had been invited to sacrifice. It
+ * halved, 30 -> 15 fps, at an unchanged bitrate - the exact opposite of the request.
+ * Keep the whole table here rather than only the bits in use, so the next field to be
+ * asserted is read off a list instead of re-derived. */
+#define UVCX_HINT_RESOLUTION      0x0001
+#define UVCX_HINT_PROFILE         0x0002
+#define UVCX_HINT_RATECONTROL     0x0004
+#define UVCX_HINT_USAGE           0x0008
+#define UVCX_HINT_SLICEMODE       0x0010
+#define UVCX_HINT_SLICEUNITS      0x0020
+#define UVCX_HINT_MVCVIEW         0x0040
+#define UVCX_HINT_TEMPORAL        0x0080
+#define UVCX_HINT_SNR             0x0100
+#define UVCX_HINT_SPATIAL         0x0200
+#define UVCX_HINT_SPATIAL_RATIO   0x0400
+#define UVCX_HINT_FRAME_INTERVAL  0x0800
+#define UVCX_HINT_LEAKY_BKT_SIZE  0x1000
+#define UVCX_HINT_BITRATE         0x2000
+#define UVCX_HINT_ENTROPY         0x4000
+#define UVCX_HINT_IFRAME_PERIOD   0x8000
+
+/* bRateControlMode carries a mode in the low nibble plus a flag: FIXED_FRAME_RATE means
+ * "do not drop frames to stay inside the bitrate". That is the second, independent half of
+ * pinning the frame rate - hinting dwFrameInterval says "do not change this number", this
+ * says "do not miss it" - and a camera may honour either one alone. */
+#define UVCX_RC_MODE_MASK         0x0f
+#define UVCX_RC_CBR               0x01
+#define UVCX_RC_VBR               0x02
+#define UVCX_RC_CONST_QP          0x03
+#define UVCX_RC_FIXED_FRAME_RATE  0x10
+
+/* dwFrameInterval is in 100 ns units, so this is the numerator of "interval for N fps". */
+#define UVCX_INTERVAL_UNITS_PER_S 10000000.0f
+
+/* The configured bitrate is a budget for this reference resolution.
+ * uvc_host_stream_h264_set_rate() scales it to whatever the stream actually negotiated, so a
+ * change of capture resolution carries its own budget with it. */
+#define UVCX_H264_BITRATE_REF_W      1280u
+#define UVCX_H264_BITRATE_REF_H      720u
+#define UVCX_H264_BITRATE_REF_PIXELS (UVCX_H264_BITRATE_REF_W * UVCX_H264_BITRATE_REF_H)
+
+typedef struct __attribute__((packed)) {
+    uint32_t dwFrameInterval;
+    uint32_t dwBitRate;
+    uint16_t bmHints;
+    uint16_t wConfigurationIndex;
+    uint16_t wWidth;
+    uint16_t wHeight;
+    uint16_t wSliceUnits;
+    uint16_t wSliceMode;
+    uint16_t wProfile;
+    uint16_t wIFramePeriod;
+    uint16_t wEstimatedVideoDelay;
+    uint16_t wEstimatedMaxConfigDelay;
+    uint8_t  bUsageType;
+    uint8_t  bRateControlMode;
+    uint8_t  bTemporalScaleMode;
+    uint8_t  bSpatialScaleMode;
+    uint8_t  bSNRScaleMode;
+    uint8_t  bStreamMuxOption;
+    uint8_t  bStreamFormat;
+    uint8_t  bEntropyCABAC;
+    uint8_t  bTimestamp;
+    uint8_t  bNumOfReorderFrames;
+    uint8_t  bPreviewFlipped;
+    uint8_t  bView;
+    uint8_t  bReserved1;
+    uint8_t  bReserved2;
+    uint8_t  bStreamID;
+    uint8_t  bSpatialLayerRatio;
+    uint16_t wLeakyBucketSize;
+} uvcx_video_config_t;
+
+static esp_err_t uvcx_xfer(uvc_host_stream_hdl_t stream_hdl, uint8_t unit_id, uint8_t vc_intf,
+                           uint8_t selector, enum uvc_req_code req, void *data, uint16_t len)
+{
+    uint8_t bmRequestType = USB_BM_REQUEST_TYPE_TYPE_CLASS | USB_BM_REQUEST_TYPE_RECIP_INTERFACE;
+    bmRequestType |= (req == UVC_SET_CUR) ? USB_BM_REQUEST_TYPE_DIR_OUT : USB_BM_REQUEST_TYPE_DIR_IN;
+
+    /* Unit controls address the VideoControl interface: wIndex carries the unit ID in the
+     * high byte, the interface number in the low byte. */
+    return uvc_host_usb_ctrl(stream_hdl, bmRequestType, (uint8_t) req,
+                             (uint16_t) selector << 8,
+                             ((uint16_t) unit_id << 8) | vc_intf,
+                             len, (uint8_t *) data);
+}
+
+/* GUID of the H.264 extension unit, little-endian as it appears in the descriptor. */
+static const uint8_t uvcx_h264_guid[16] = {
+    0x41, 0x76, 0x9e, 0xa2, 0x04, 0xde, 0xe3, 0x47,
+    0x8b, 0x2b, 0xf4, 0x34, 0x1a, 0xff, 0x00, 0x3b
+};
+
+/* Locate the H.264 extension unit by GUID rather than trusting a configured ID: unit
+ * numbering is per-camera, and this camera alone exposes six extension units. */
+static esp_err_t uvcx_find_h264_unit(const usb_config_desc_t *cfg_desc, uint8_t *unit_id, uint8_t *vc_intf)
+{
+    int offset = 0;
+    const usb_standard_desc_t *desc = (const usb_standard_desc_t *) cfg_desc;
+    uint8_t current_vc_intf = 0;
+
+    while ((desc = usb_parse_next_descriptor(desc, cfg_desc->wTotalLength, &offset)) != NULL) {
+        if (desc->bDescriptorType == USB_B_DESCRIPTOR_TYPE_INTERFACE) {
+            const usb_intf_desc_t *intf = (const usb_intf_desc_t *) desc;
+            if (intf->bInterfaceSubClass == UVC_SC_VIDEOCONTROL) {
+                current_vc_intf = intf->bInterfaceNumber;
+            }
+            continue;
+        }
+        if (desc->bDescriptorType != UVC_CS_INTERFACE || desc->bLength < 24) {
+            continue;
+        }
+        const uint8_t *raw = (const uint8_t *) desc;
+        if (raw[2] != UVC_VC_DESC_SUBTYPE_EXTENSION_UNIT) {
+            continue;
+        }
+        /* Layout: bLength, bDescriptorType, bDescriptorSubType, bUnitID, guid[16]... */
+        if (memcmp(&raw[4], uvcx_h264_guid, sizeof(uvcx_h264_guid)) == 0) {
+            *unit_id = raw[3];
+            *vc_intf = current_vc_intf;
+            return ESP_OK;
+        }
+    }
+    return ESP_ERR_NOT_FOUND;
 }
 
+esp_err_t uvc_host_stream_h264_set_rate(uvc_host_stream_hdl_t stream_hdl, uint32_t bitrate_bps,
+                                        uint16_t iframe_period_ms, uint32_t frame_interval_100ns,
+                                        uint32_t *committed_bps)
+{
+    UVC_CHECK(stream_hdl != NULL, ESP_ERR_INVALID_ARG);
+    uvc_stream_t *uvc_stream = (uvc_stream_t *) stream_hdl;
+    const usb_config_desc_t *cfg_desc;
+    uint8_t unit_id = 0, vc_intf = 0;
+    uvcx_video_config_t cfg = {0};
+
+    ESP_RETURN_ON_ERROR(usb_host_get_active_config_descriptor(uvc_stream->constant.dev_hdl, &cfg_desc),
+                        TAG, "Could not read the configuration descriptor");
+    ESP_RETURN_ON_ERROR(uvcx_find_h264_unit(cfg_desc, &unit_id, &vc_intf),
+                        TAG, "No H.264 extension unit on this camera");
+    ESP_LOGI(TAG, "H.264 extension unit: bUnitID %u on VideoControl interface %u", unit_id, vc_intf);
+
+    /* Read what the camera is doing now, change only what we care about, then probe so it
+     * can clamp our values, and commit whatever it agreed to. */
+    ESP_RETURN_ON_ERROR(uvcx_xfer(stream_hdl, unit_id, vc_intf, UVCX_VIDEO_CONFIG_PROBE,
+                                  UVC_GET_CUR, &cfg, sizeof(cfg)),
+                        TAG, "H.264 XU not readable (camera may not implement it)");
+
+    ESP_LOGI(TAG, "camera H.264 config: %ux%u, %" PRIu32 " bps, IFramePeriod %u ms, "
+                  "interval %" PRIu32 ", rc_mode 0x%02x, hints 0x%04x",
+             cfg.wWidth, cfg.wHeight, cfg.dwBitRate, cfg.wIFramePeriod,
+             cfg.dwFrameInterval, cfg.bRateControlMode, cfg.bmHints);
+
+    /* Build bmHints from nothing rather than adding to what the read-back returned. It is a
+     * host-to-device directive for THIS transaction, not device state, and the read-back
+     * merely echoes it - so accumulating would make a hint permanent once set: the frame-rate
+     * pin could be turned on but never off again, which is exactly what the mid-stream and
+     * restart actuation paths need to be able to do. */
+    cfg.bmHints = 0;
+
+    /* The H.264 config carries its own resolution, and per the UVC H.264 payload spec it
+     * must match the frame descriptor the stream was committed to. A camera whose encoder
+     * still says 1920x1080 while the stream negotiated 640x480 rejects the whole probe -
+     * silently, by returning its current values from the read-back - and then produces no
+     * payloads at all. So make the resolution follow whatever the stream actually
+     * negotiated rather than leaving the camera's default in place. */
+    uvc_host_stream_format_t stream_fmt = {0};
+    if (uvc_host_stream_format_get(stream_hdl, &stream_fmt) == ESP_OK &&
+            stream_fmt.h_res && stream_fmt.v_res) {
+        if (cfg.wWidth != stream_fmt.h_res || cfg.wHeight != stream_fmt.v_res) {
+            ESP_LOGI(TAG, "H.264 XU resolution %ux%u -> %ux%u (matching the negotiated stream)",
+                     cfg.wWidth, cfg.wHeight, stream_fmt.h_res, stream_fmt.v_res);
+        }
+        cfg.wWidth  = stream_fmt.h_res;
+        cfg.wHeight = stream_fmt.v_res;
+    }
+    /* Asserted, not merely written: a camera that moved the encoder off the negotiated
+     * resolution to meet some other constraint would produce payloads the stream cannot
+     * carry. */
+    cfg.bmHints |= UVCX_HINT_RESOLUTION;
+
+    /* Scale the budget to the resolution negotiated just above.
+     *
+     * Resolution and bitrate used to be set independently here: wWidth/wHeight followed the
+     * stream, dwBitRate did not. A 1080p stream then ran on a budget chosen for 720p, and a
+     * camera's rate controller holds bits-per-pixel roughly constant - so it sheds frame rate
+     * instead, 30 fps becoming ~13. That surfaces as a frame-rate fault a long way from its
+     * cause, which is why the scaling belongs next to the resolution it depends on.
+     *
+     * Linear in pixel count only. It deliberately does not model frame rate: what the camera
+     * actually delivers is not reliably ours to know, and a wrong fps term would only be a
+     * second silent scaling error of the same shape. */
+    if (bitrate_bps) {
+        const uint32_t pixels = (uint32_t) cfg.wWidth * (uint32_t) cfg.wHeight;
+
+        if (pixels && pixels != UVCX_H264_BITRATE_REF_PIXELS) {
+            const uint32_t scaled =
+                (uint32_t) (((uint64_t) bitrate_bps * pixels) / UVCX_H264_BITRATE_REF_PIXELS);
+            ESP_LOGI(TAG, "H.264 bitrate %" PRIu32 " -> %" PRIu32 " bps for %ux%u "
+                          "(configured value is the budget at %ux%u)",
+                     bitrate_bps, scaled, cfg.wWidth, cfg.wHeight,
+                     UVCX_H264_BITRATE_REF_W, UVCX_H264_BITRATE_REF_H);
+            bitrate_bps = scaled;   /* also what the clamp check below compares against */
+        }
+        cfg.dwBitRate = bitrate_bps;
+        cfg.bmHints |= UVCX_HINT_BITRATE;
+    }
+    if (iframe_period_ms) {
+        cfg.wIFramePeriod = iframe_period_ms;
+        cfg.bmHints |= UVCX_HINT_IFRAME_PERIOD;
+    }
+
+    /* Pinning the frame interval is what decides HOW the camera spends a bitrate it
+     * cannot meet at full quality.
+     *
+     * Left alone (0), the camera's own rate controller holds bits-per-pixel roughly
+     * constant and sheds frame rate instead - measured on ESP32-S31: 1080p at 256 kbps
+     * delivered 4 fps, and 30 -> 20 fps at a fixed 800 kbps left the bitrate unchanged
+     * while doubling per-frame size. Quality is preserved, smoothness is not.
+     *
+     * Hinting dwFrameInterval tells it the frame rate is not negotiable, so the only
+     * variable left is quality: it must fit each frame into bitrate/fps bits and raise
+     * QP to get there. Smoothness is preserved, sharpness is not.
+     *
+     * Neither is universally right - a security camera wants the frames, a
+     * detail-inspection view wants the pixels - so the caller chooses. */
+    cfg.bRateControlMode &= (uint8_t) ~UVCX_RC_FIXED_FRAME_RATE;
+    if (frame_interval_100ns) {
+        /* The XU's frame interval has to agree with the one the VideoStreaming commit
+         * negotiated - the same rule as wWidth/wHeight above, and the isochronous geometry
+         * was provisioned for that rate. A caller asking to pin a rate the stream is not
+         * running at would be asking the camera to hold two different frame rates fixed at
+         * once, and the caller cannot know the negotiated rate anyway: this configuration is
+         * applied during stream setup, before V4L2 can read it back. */
+        if (stream_fmt.fps > 0.0f) {
+            const uint32_t negotiated =
+                (uint32_t) (UVCX_INTERVAL_UNITS_PER_S / stream_fmt.fps + 0.5f);
+            if (negotiated != 0 && negotiated != frame_interval_100ns) {
+                ESP_LOGI(TAG, "H.264 XU frame interval %" PRIu32 " -> %" PRIu32
+                              " (matching the negotiated %.0f fps)",
+                         frame_interval_100ns, negotiated, stream_fmt.fps);
+                frame_interval_100ns = negotiated;
+            }
+        }
+        cfg.dwFrameInterval = frame_interval_100ns;
+        cfg.bmHints |= UVCX_HINT_FRAME_INTERVAL;
+        cfg.bRateControlMode |= UVCX_RC_FIXED_FRAME_RATE;
+    }
+    /* Either way the rate-control byte is now ours to assert - with the flag set when the
+     * frame rate is pinned and cleared when it is not. Leaving it unhinted is what lets a
+     * camera keep frame dropping enabled while agreeing to the interval. */
+    cfg.bmHints |= UVCX_HINT_RATECONTROL;
+
+    ESP_RETURN_ON_ERROR(uvcx_xfer(stream_hdl, unit_id, vc_intf, UVCX_VIDEO_CONFIG_PROBE,
+                                  UVC_SET_CUR, &cfg, sizeof(cfg)),
+                        TAG, "H.264 XU probe rejected");
+    ESP_RETURN_ON_ERROR(uvcx_xfer(stream_hdl, unit_id, vc_intf, UVCX_VIDEO_CONFIG_PROBE,
+                                  UVC_GET_CUR, &cfg, sizeof(cfg)),
+                        TAG, "H.264 XU probe read-back failed");
+    ESP_RETURN_ON_ERROR(uvcx_xfer(stream_hdl, unit_id, vc_intf, UVCX_VIDEO_CONFIG_COMMIT,
+                                  UVC_SET_CUR, &cfg, sizeof(cfg)),
+                        TAG, "H.264 XU commit rejected");
+
+    ESP_LOGI(TAG, "camera H.264 committed: %ux%u, %" PRIu32 " bps, IFramePeriod %u ms, "
+                  "interval %" PRIu32 ", rc_mode 0x%02x (%s)",
+             cfg.wWidth, cfg.wHeight, cfg.dwBitRate, cfg.wIFramePeriod, cfg.dwFrameInterval,
+             cfg.bRateControlMode,
+             frame_interval_100ns ? "frame rate pinned - quality gives way"
+                                  : "frame rate free - the camera may shed fps");
+    /* The frame interval belongs in this check as much as the bitrate does: a camera that
+     * takes the bitrate and quietly returns a different interval has accepted the budget and
+     * refused the terms, which reads as a frame-rate fault a long way from here. */
+    if ((bitrate_bps && cfg.dwBitRate != bitrate_bps) ||
+            (iframe_period_ms && cfg.wIFramePeriod != iframe_period_ms) ||
+            (frame_interval_100ns && cfg.dwFrameInterval != frame_interval_100ns)) {
+        ESP_LOGW(TAG, "camera kept its own values (asked %" PRIu32 " bps / %u ms / interval "
+                      "%" PRIu32 ") - it clamped or rejected the request",
+                 bitrate_bps, iframe_period_ms, frame_interval_100ns);
+    }
+    if (frame_interval_100ns && !(cfg.bRateControlMode & UVCX_RC_FIXED_FRAME_RATE)) {
+        ESP_LOGW(TAG, "camera cleared the fixed-frame-rate flag - it may still drop frames to "
+                      "stay inside %" PRIu32 " bps", cfg.dwBitRate);
+    }
+    if (committed_bps != NULL) {
+        *committed_bps = cfg.dwBitRate;
+    }
+    return ESP_OK;
+}
+
+/* Camera Terminal, UVC 1.5 section 4.2.2.1. Auto-Exposure Priority is the ONLY control
+ * that decides frame rate versus exposure, and that trade is upstream of the encoder:
+ *
+ *   0 = constant frame rate. Auto-exposure may not lengthen exposure past the frame
+ *       interval, so a dim scene comes back dark and noisy at full rate.
+ *   1 = frame rate may vary. Auto-exposure lengthens exposure for a correct picture and
+ *       the sensor rate falls to suit - the UVC default, and why a camera indoors after
+ *       dark quietly delivers half its nominal fps.
+ *
+ * Measured on ESP32-S31 at 720p: 14-15 fps whatever the H.264 extension unit was told.
+ * Raising the bitrate 800 kbps -> 2.4 Mbps tripled the average frame (6.5 -> 20.2 KB) and
+ * produced no extra frames, which is what proves the ceiling is the sensor and not the
+ * encoder. No encoder setting can create a frame that was never captured, so the H.264
+ * bitrate hints cannot reach this and the frame-rate/quality choice has to be made here
+ * as well as there. */
+#define UVC_CT_AE_MODE_CONTROL       0x02
+#define UVC_CT_AE_PRIORITY_CONTROL   0x03
+
+#define UVC_ITT_CAMERA               0x0201
+/* Camera Terminal bmControls, UVC 1.5 table 3-6. D2 is Auto-Exposure Priority. */
+#define UVC_CT_BMCONTROL_AE_PRIORITY 0x04
+
+/* Locate the Camera Terminal and report whether it claims the AE Priority control.
+ * Checking bmControls first is not defensive noise: a camera that does not implement a
+ * control STALLs EP0, and USBH logs that at ERROR, so an unconditional write would put an
+ * error in the log of every boot on cameras that simply do not have it. */
+static esp_err_t uvc_find_camera_terminal(const usb_config_desc_t *cfg_desc, uint8_t *terminal_id,
+                                          uint8_t *vc_intf, bool *has_ae_priority)
+{
+    int offset = 0;
+    const usb_standard_desc_t *desc = (const usb_standard_desc_t *) cfg_desc;
+    uint8_t current_vc_intf = 0;
+
+    while ((desc = usb_parse_next_descriptor(desc, cfg_desc->wTotalLength, &offset)) != NULL) {
+        if (desc->bDescriptorType == USB_B_DESCRIPTOR_TYPE_INTERFACE) {
+            const usb_intf_desc_t *intf = (const usb_intf_desc_t *) desc;
+            if (intf->bInterfaceSubClass == UVC_SC_VIDEOCONTROL) {
+                current_vc_intf = intf->bInterfaceNumber;
+            }
+            continue;
+        }
+        if (desc->bDescriptorType != UVC_CS_INTERFACE || desc->bLength < 15) {
+            continue;
+        }
+        const uint8_t *raw = (const uint8_t *) desc;
+        if (raw[2] != UVC_VC_DESC_SUBTYPE_INPUT_TERMINAL) {
+            continue;
+        }
+        /* Layout: bLength, bDescriptorType, bDescriptorSubType, bTerminalID,
+         * wTerminalType (LE), bAssocTerminal, iTerminal, wObjectiveFocalLengthMin,
+         * wObjectiveFocalLengthMax, wOcularFocalLength, bControlSize, bmControls... */
+        if ((uint16_t) (raw[4] | (raw[5] << 8)) != UVC_ITT_CAMERA) {
+            continue;
+        }
+        *terminal_id = raw[3];
+        *vc_intf     = current_vc_intf;
+        const uint8_t control_size = raw[14];
+        *has_ae_priority = (control_size >= 1) && ((raw[15] & UVC_CT_BMCONTROL_AE_PRIORITY) != 0);
+        return ESP_OK;
+    }
+    return ESP_ERR_NOT_FOUND;
+}
+
+esp_err_t uvc_host_stream_set_ae_priority(uvc_host_stream_hdl_t stream_hdl, uint8_t priority,
+                                          uint8_t *committed)
+{
+    UVC_CHECK(stream_hdl != NULL, ESP_ERR_INVALID_ARG);
+    UVC_CHECK(priority <= 1, ESP_ERR_INVALID_ARG);
+    uvc_stream_t *uvc_stream = (uvc_stream_t *) stream_hdl;
+    const usb_config_desc_t *cfg_desc;
+    uint8_t terminal_id = 0, vc_intf = 0;
+    bool has_ae_priority = false;
+
+    ESP_RETURN_ON_ERROR(usb_host_get_active_config_descriptor(uvc_stream->constant.dev_hdl, &cfg_desc),
+                        TAG, "Could not read the configuration descriptor");
+    ESP_RETURN_ON_ERROR(uvc_find_camera_terminal(cfg_desc, &terminal_id, &vc_intf, &has_ae_priority),
+                        TAG, "No Camera Terminal on this camera");
+    if (!has_ae_priority) {
+        ESP_LOGW(TAG, "Camera Terminal %u does not implement AE Priority - the sensor frame "
+                      "rate is not controllable on this camera", terminal_id);
+        return ESP_ERR_NOT_SUPPORTED;
+    }
+
+    uint8_t value = priority;
+    ESP_RETURN_ON_ERROR(uvcx_xfer(stream_hdl, terminal_id, vc_intf, UVC_CT_AE_PRIORITY_CONTROL,
+                                  UVC_SET_CUR, &value, sizeof(value)),
+                        TAG, "AE Priority write rejected");
+    /* Read back rather than trust the write: this is the same class of control as the H.264
+     * extension unit, where a SET_CUR succeeded and the value was quietly ignored. */
+    value = 0xff;
+    ESP_RETURN_ON_ERROR(uvcx_xfer(stream_hdl, terminal_id, vc_intf, UVC_CT_AE_PRIORITY_CONTROL,
+                                  UVC_GET_CUR, &value, sizeof(value)),
+                        TAG, "AE Priority read-back failed");
+
+    ESP_LOGI(TAG, "AE Priority on Camera Terminal %u: asked %u, committed %u (%s)",
+             terminal_id, priority, value,
+             value == 0 ? "constant frame rate - exposure gives way"
+                        : "frame rate may vary - exposure wins");
+    if (value != priority) {
+        ESP_LOGW(TAG, "camera kept AE Priority %u - it refused the request", value);
+    }
+    if (committed != NULL) {
+        *committed = value;
+    }
+    return ESP_OK;
+}
+
+esp_err_t uvc_host_stream_request_key_frame(uvc_host_stream_hdl_t stream_hdl)
+{
+    UVC_CHECK(stream_hdl != NULL, ESP_ERR_INVALID_ARG);
+    uvc_stream_t *uvc_stream = (uvc_stream_t *)stream_hdl;
+
+    /* UVC 1.5 A.9.8: a one-byte SET_CUR of the VideoStreaming Generate Key Frame
+     * control asks the camera to emit a key frame now (value 1). Cameras with long
+     * default GOPs otherwise leave a joining viewer waiting seconds for an IDR - and
+     * on a lossy link the rare large IDR may never arrive intact at all. */
+    uint8_t generate = 1;
+    const uint8_t bmRequestType = USB_BM_REQUEST_TYPE_TYPE_CLASS | USB_BM_REQUEST_TYPE_RECIP_INTERFACE |
+                                  USB_BM_REQUEST_TYPE_DIR_OUT;
+
+    return uvc_host_usb_ctrl(stream_hdl, bmRequestType, UVC_SET_CUR,
+                             UVC_VS_GENERATE_KEY_FRAME_CONTROL << 8,
+                             uvc_stream->constant.bInterfaceNumber,
+                             sizeof(generate), &generate);
+}
+
 static inline esp_err_t uvc_control_probe_set(uvc_host_stream_hdl_t stream_hdl, uvc_vs_ctrl_t *vs_control, const uvc_host_stream_format_t *vs_format)
 {
