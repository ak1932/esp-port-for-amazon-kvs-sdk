+/* UVC H.264 Extension Unit (GUID A29E7641-DE04-47E3-8B2B-F4341AFF003B), as defined by
+ * the USB Video Class H.264 payload spec and implemented by H.264-capable UVC cameras.
+ * It is the only way to reach the camera's own encoder settings: bitrate and key-frame
+ * period. Without it a camera streams at whatever rate it likes (~3 Mbps measured, at
+ * every resolution) with a multi-second GOP, which no constrained uplink can carry and
+ * no viewer can start decoding. */
+#define UVCX_VIDEO_CONFIG_PROBE   0x01
+#define UVCX_VIDEO_CONFIG_COMMIT  0x02
+#define UVCX_PICTURE_TYPE_CONTROL 0x09
+
+#define UVCX_HINT_BITRATE         0x0002
+#define UVCX_HINT_IFRAME_PERIOD   0x2000
+
+/* The configured bitrate is a budget for this reference resolution.
+ * uvc_host_stream_h264_set_rate() scales it to whatever the stream actually negotiated, so a
+ * change of capture resolution carries its own budget with it. */
+#define UVCX_H264_BITRATE_REF_W      1280u
+#define UVCX_H264_BITRATE_REF_H      720u
+#define UVCX_H264_BITRATE_REF_PIXELS (UVCX_H264_BITRATE_REF_W * UVCX_H264_BITRATE_REF_H)
+
+typedef struct __attribute__((packed)) {
+    uint32_t dwFrameInterval;
+    uint32_t dwBitRate;
+    uint16_t bmHints;
+    uint16_t wConfigurationIndex;
+    uint16_t wWidth;
+    uint16_t wHeight;
+    uint16_t wSliceUnits;
+    uint16_t wSliceMode;
+    uint16_t wProfile;
+    uint16_t wIFramePeriod;
+    uint16_t wEstimatedVideoDelay;
+    uint16_t wEstimatedMaxConfigDelay;
+    uint8_t  bUsageType;
+    uint8_t  bRateControlMode;
+    uint8_t  bTemporalScaleMode;
+    uint8_t  bSpatialScaleMode;
+    uint8_t  bSNRScaleMode;
+    uint8_t  bStreamMuxOption;
+    uint8_t  bStreamFormat;
+    uint8_t  bEntropyCABAC;
+    uint8_t  bTimestamp;
+    uint8_t  bNumOfReorderFrames;
+    uint8_t  bPreviewFlipped;
+    uint8_t  bView;
+    uint8_t  bReserved1;
+    uint8_t  bReserved2;
+    uint8_t  bStreamID;
+    uint8_t  bSpatialLayerRatio;
+    uint16_t wLeakyBucketSize;
+} uvcx_video_config_t;
+
+static esp_err_t uvcx_xfer(uvc_host_stream_hdl_t stream_hdl, uint8_t unit_id, uint8_t vc_intf,
+                           uint8_t selector, enum uvc_req_code req, void *data, uint16_t len)
+{
+    uint8_t bmRequestType = USB_BM_REQUEST_TYPE_TYPE_CLASS | USB_BM_REQUEST_TYPE_RECIP_INTERFACE;
+    bmRequestType |= (req == UVC_SET_CUR) ? USB_BM_REQUEST_TYPE_DIR_OUT : USB_BM_REQUEST_TYPE_DIR_IN;
+
+    /* Unit controls address the VideoControl interface: wIndex carries the unit ID in the
+     * high byte, the interface number in the low byte. */
+    return uvc_host_usb_ctrl(stream_hdl, bmRequestType, (uint8_t) req,
+                             (uint16_t) selector << 8,
+                             ((uint16_t) unit_id << 8) | vc_intf,
+                             len, (uint8_t *) data);
+}
+
+/* GUID of the H.264 extension unit, little-endian as it appears in the descriptor. */
+static const uint8_t uvcx_h264_guid[16] = {
+    0x41, 0x76, 0x9e, 0xa2, 0x04, 0xde, 0xe3, 0x47,
+    0x8b, 0x2b, 0xf4, 0x34, 0x1a, 0xff, 0x00, 0x3b
+};
+
+/* Locate the H.264 extension unit by GUID rather than trusting a configured ID: unit
+ * numbering is per-camera, and this camera alone exposes six extension units. */
+static esp_err_t uvcx_find_h264_unit(const usb_config_desc_t *cfg_desc, uint8_t *unit_id, uint8_t *vc_intf)
+{
+    int offset = 0;
+    const usb_standard_desc_t *desc = (const usb_standard_desc_t *) cfg_desc;
+    uint8_t current_vc_intf = 0;
+
+    while ((desc = usb_parse_next_descriptor(desc, cfg_desc->wTotalLength, &offset)) != NULL) {
+        if (desc->bDescriptorType == USB_B_DESCRIPTOR_TYPE_INTERFACE) {
+            const usb_intf_desc_t *intf = (const usb_intf_desc_t *) desc;
+            if (intf->bInterfaceSubClass == UVC_SC_VIDEOCONTROL) {
+                current_vc_intf = intf->bInterfaceNumber;
+            }
+            continue;
+        }
+        if (desc->bDescriptorType != UVC_CS_INTERFACE || desc->bLength < 24) {
+            continue;
+        }
+        const uint8_t *raw = (const uint8_t *) desc;
+        if (raw[2] != UVC_VC_DESC_SUBTYPE_EXTENSION_UNIT) {
+            continue;
+        }
+        /* Layout: bLength, bDescriptorType, bDescriptorSubType, bUnitID, guid[16]... */
+        if (memcmp(&raw[4], uvcx_h264_guid, sizeof(uvcx_h264_guid)) == 0) {
+            *unit_id = raw[3];
+            *vc_intf = current_vc_intf;
+            return ESP_OK;
+        }
+    }
+    return ESP_ERR_NOT_FOUND;
+}
+
+esp_err_t uvc_host_stream_h264_set_rate(uvc_host_stream_hdl_t stream_hdl, uint32_t bitrate_bps,
+                                        uint16_t iframe_period_ms)
+{
+    UVC_CHECK(stream_hdl != NULL, ESP_ERR_INVALID_ARG);
+    uvc_stream_t *uvc_stream = (uvc_stream_t *) stream_hdl;
+    const usb_config_desc_t *cfg_desc;
+    uint8_t unit_id = 0, vc_intf = 0;
+    uvcx_video_config_t cfg = {0};
+
+    ESP_RETURN_ON_ERROR(usb_host_get_active_config_descriptor(uvc_stream->constant.dev_hdl, &cfg_desc),
+                        TAG, "Could not read the configuration descriptor");
+    ESP_RETURN_ON_ERROR(uvcx_find_h264_unit(cfg_desc, &unit_id, &vc_intf),
+                        TAG, "No H.264 extension unit on this camera");
+    ESP_LOGI(TAG, "H.264 extension unit: bUnitID %u on VideoControl interface %u", unit_id, vc_intf);
+
+    /* Read what the camera is doing now, change only what we care about, then probe so it
+     * can clamp our values, and commit whatever it agreed to. */
+    ESP_RETURN_ON_ERROR(uvcx_xfer(stream_hdl, unit_id, vc_intf, UVCX_VIDEO_CONFIG_PROBE,
+                                  UVC_GET_CUR, &cfg, sizeof(cfg)),
+                        TAG, "H.264 XU not readable (camera may not implement it)");
+
+    ESP_LOGI(TAG, "camera H.264 config: %ux%u, %" PRIu32 " bps, IFramePeriod %u ms, rc_mode %u",
+             cfg.wWidth, cfg.wHeight, cfg.dwBitRate, cfg.wIFramePeriod, cfg.bRateControlMode);
+
+    /* The H.264 config carries its own resolution, and per the UVC H.264 payload spec it
+     * must match the frame descriptor the stream was committed to. A camera whose encoder
+     * still says 1920x1080 while the stream negotiated 640x480 rejects the whole probe -
+     * silently, by returning its current values from the read-back - and then produces no
+     * payloads at all. So make the resolution follow whatever the stream actually
+     * negotiated rather than leaving the camera's default in place. */
+    uvc_host_stream_format_t stream_fmt = {0};
+    if (uvc_host_stream_format_get(stream_hdl, &stream_fmt) == ESP_OK &&
+            stream_fmt.h_res && stream_fmt.v_res) {
+        if (cfg.wWidth != stream_fmt.h_res || cfg.wHeight != stream_fmt.v_res) {
+            ESP_LOGI(TAG, "H.264 XU resolution %ux%u -> %ux%u (matching the negotiated stream)",
+                     cfg.wWidth, cfg.wHeight, stream_fmt.h_res, stream_fmt.v_res);
+        }
+        cfg.wWidth  = stream_fmt.h_res;
+        cfg.wHeight = stream_fmt.v_res;
+    }
+
+    /* Scale the budget to the resolution negotiated just above.
+     *
+     * Resolution and bitrate used to be set independently here: wWidth/wHeight followed the
+     * stream, dwBitRate did not. A 1080p stream then ran on a budget chosen for 720p, and a
+     * camera's rate controller holds bits-per-pixel roughly constant - so it sheds frame rate
+     * instead, 30 fps becoming ~13. That surfaces as a frame-rate fault a long way from its
+     * cause, which is why the scaling belongs next to the resolution it depends on.
+     *
+     * Linear in pixel count only. It deliberately does not model frame rate: what the camera
+     * actually delivers is not reliably ours to know, and a wrong fps term would only be a
+     * second silent scaling error of the same shape. */
+    if (bitrate_bps) {
+        const uint32_t pixels = (uint32_t) cfg.wWidth * (uint32_t) cfg.wHeight;
+
+        if (pixels && pixels != UVCX_H264_BITRATE_REF_PIXELS) {
+            const uint32_t scaled =
+                (uint32_t) (((uint64_t) bitrate_bps * pixels) / UVCX_H264_BITRATE_REF_PIXELS);
+            ESP_LOGI(TAG, "H.264 bitrate %" PRIu32 " -> %" PRIu32 " bps for %ux%u "
+                          "(configured value is the budget at %ux%u)",
+                     bitrate_bps, scaled, cfg.wWidth, cfg.wHeight,
+                     UVCX_H264_BITRATE_REF_W, UVCX_H264_BITRATE_REF_H);
+            bitrate_bps = scaled;   /* also what the clamp check below compares against */
+        }
+        cfg.dwBitRate = bitrate_bps;
+        cfg.bmHints |= UVCX_HINT_BITRATE;
+    }
+    if (iframe_period_ms) {
+        cfg.wIFramePeriod = iframe_period_ms;
+        cfg.bmHints |= UVCX_HINT_IFRAME_PERIOD;
+    }
+
+    ESP_RETURN_ON_ERROR(uvcx_xfer(stream_hdl, unit_id, vc_intf, UVCX_VIDEO_CONFIG_PROBE,
+                                  UVC_SET_CUR, &cfg, sizeof(cfg)),
+                        TAG, "H.264 XU probe rejected");
+    ESP_RETURN_ON_ERROR(uvcx_xfer(stream_hdl, unit_id, vc_intf, UVCX_VIDEO_CONFIG_PROBE,
+                                  UVC_GET_CUR, &cfg, sizeof(cfg)),
+                        TAG, "H.264 XU probe read-back failed");
+    ESP_RETURN_ON_ERROR(uvcx_xfer(stream_hdl, unit_id, vc_intf, UVCX_VIDEO_CONFIG_COMMIT,
+                                  UVC_SET_CUR, &cfg, sizeof(cfg)),
+                        TAG, "H.264 XU commit rejected");
+
+    ESP_LOGI(TAG, "camera H.264 committed: %ux%u, %" PRIu32 " bps, IFramePeriod %u ms",
+             cfg.wWidth, cfg.wHeight, cfg.dwBitRate, cfg.wIFramePeriod);
+    if ((bitrate_bps && cfg.dwBitRate != bitrate_bps) ||
+            (iframe_period_ms && cfg.wIFramePeriod != iframe_period_ms)) {
+        ESP_LOGW(TAG, "camera kept its own values (asked %" PRIu32 " bps / %u ms) - it clamped or "
+                      "rejected the request", bitrate_bps, iframe_period_ms);
+    }
+    return ESP_OK;
+}
+
+esp_err_t uvc_host_stream_request_key_frame(uvc_host_stream_hdl_t stream_hdl)
+{
+    UVC_CHECK(stream_hdl != NULL, ESP_ERR_INVALID_ARG);
+    uvc_stream_t *uvc_stream = (uvc_stream_t *)stream_hdl;
+
+    /* UVC 1.5 A.9.8: a one-byte SET_CUR of the VideoStreaming Generate Key Frame
+     * control asks the camera to emit a key frame now (value 1). Cameras with long
+     * default GOPs otherwise leave a joining viewer waiting seconds for an IDR - and
+     * on a lossy link the rare large IDR may never arrive intact at all. */
+    uint8_t generate = 1;
+    const uint8_t bmRequestType = USB_BM_REQUEST_TYPE_TYPE_CLASS | USB_BM_REQUEST_TYPE_RECIP_INTERFACE |
+                                  USB_BM_REQUEST_TYPE_DIR_OUT;
+
+    return uvc_host_usb_ctrl(stream_hdl, bmRequestType, UVC_SET_CUR,
+                             UVC_VS_GENERATE_KEY_FRAME_CONTROL << 8,
+                             uvc_stream->constant.bInterfaceNumber,
+                             sizeof(generate), &generate);
+}
+
 static inline esp_err_t uvc_control_probe_set(uvc_host_stream_hdl_t stream_hdl, uvc_vs_ctrl_t *vs_control, const uvc_host_stream_format_t *vs_format)
 {
     return uvc_host_stream_control(stream_hdl, vs_control, (uvc_host_stream_format_t *)vs_format, UVC_SET_CUR, false);
