+     * key-frame period so a joining viewer gets something decodable quickly. Both live in
+     * the H.264 extension unit; cameras without it simply refuse and keep their defaults. */
+    /* The committed value is kept, not the requested one: the camera clamps freely, and a
+     * rate controller must not later ask for more than it already agreed to. Leaving it 0
+     * is how "this camera has no rate-control lever" is reported. */
+    uint32_t committed = 0;
+    const uint32_t start_bps = s_h264_start_bps_override ? s_h264_start_bps_override
+                                                         : CONFIG_ESP_VIDEO_UVC_H264_BITRATE_BPS;
+    if (s_h264_start_bps_override) {
