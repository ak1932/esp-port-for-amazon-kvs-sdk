@@ -182,7 +182,39 @@
 
 
     if ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE
+
+        config ESP_VIDEO_UVC_H264_BITRATE_BPS
+            int "H.264 bitrate budget at 1280x720, in bps (0 = leave the camera alone)"
+            default 800000
+            help
+                Applied through the UVC H.264 extension unit at stream start. A camera left
+                to itself picks a rate independent of resolution (~3 Mbps observed), which a
+                constrained uplink cannot carry.
+
+                This is a budget for 1280x720. It is scaled linearly by pixel count to
+                whatever resolution the stream actually negotiates, so 800000 means 800 kbps
+                at 720p and about 1.8 Mbps at 1080p. Frame rate is not part of the scaling.
+                Holding the bitrate fixed while the resolution changed is how a 1080p stream
+                ended up on a 720p budget, where the camera keeps bits-per-pixel constant and
+                drops frame rate instead - 30 fps became 13.
+
+        config ESP_VIDEO_UVC_H264_IFRAME_PERIOD_MS
+            int "Key-frame period to request from the camera (ms, 0 = leave alone)"
+            default 1000
+            help
+                Every key frame carries the parameter sets a decoder needs to start, so a
+                multi-second default leaves joining viewers blank and makes loss recovery
+                unbounded.
 
+        config ESP_VIDEO_UVC_H264_XU_UNIT_ID
+            hex "bUnitID of the camera's H.264 extension unit"
+            default 0x0c
+
