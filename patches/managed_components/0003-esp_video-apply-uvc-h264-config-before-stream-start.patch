+/* Last started UVC stream, so a caller outside this driver can ask the camera for a key
+ * frame or change its bitrate. Passthrough streaming needs both: the camera's own
+ * key-frame interval can be many seconds, which leaves a joining viewer undecodable and
+ * makes loss recovery unbounded, and its bitrate is the only rate-control lever there is
+ * when we are not the one encoding.
+ *
+ * Cleared by uvc_video_stop(), because the handle is closed there and the next caller
+ * would otherwise hand a freed stream to the USB stack. */
+static uvc_host_stream_hdl_t s_active_stream_hdl;
+
+/* Bitrate the camera committed at stream start, and 0 when the H.264 extension unit is
+ * not usable on this camera at all. Both facts have to reach the caller: without the XU
+ * there is no rate-control lever, and with it the committed value - not what we asked
+ * for - is the ceiling a rate controller may work down from. */
+static uint32_t s_h264_committed_bps;
+
+/* Bitrate to ask for at the NEXT stream start, or 0 to use the Kconfig default.
+ *
+ * This camera - and, from the UVC H.264 spec's wording, likely others - accepts a
+ * bitrate through the extension unit only while the stream is being set up. At
+ * runtime the PROBE and COMMIT both succeed and the value is silently ignored,
+ * so a rate controller has no lever during a session. Re-applying the rate over
+ * a stream restart is the only actuation left, and this is where the restart
+ * picks up the new target.
+ *
+ * Expressed in the same terms as CONFIG_ESP_VIDEO_UVC_H264_BITRATE_BPS - a budget
+ * at the 1280x720 reference - because it is passed through the same pixel-count
+ * scaling in uvc_host_stream_h264_set_rate(). Handing it an absolute rate for the
+ * current resolution would be scaled a second time. */
+static uint32_t s_h264_start_bps_override;
+
+/* Frame interval to pin, in 100 ns units, or 0 to leave the frame rate at the camera's
+ * discretion. Decides what gives way when the bitrate is too small for the picture:
+ * 0 lets the camera hold quality and shed frame rate, non-zero fixes the frame rate and
+ * makes quality absorb the shortfall. Applied at stream start and on every mid-stream
+ * bitrate change, so the choice survives both actuation paths. */
+static uint32_t s_h264_pin_frame_interval;
+
+esp_err_t esp_video_uvc_request_key_frame(void)
+{
+    if (s_active_stream_hdl == NULL) {
+        return ESP_ERR_INVALID_STATE;
+    }
+    return uvc_host_stream_request_key_frame(s_active_stream_hdl);
+}
+
+esp_err_t esp_video_uvc_get_h264_committed_bitrate(uint32_t *bps)
+{
+    if (bps == NULL) {
+        return ESP_ERR_INVALID_ARG;
+    }
+    if (s_active_stream_hdl == NULL) {
+        return ESP_ERR_INVALID_STATE;
+    }
+    if (s_h264_committed_bps == 0) {
+        return ESP_ERR_NOT_SUPPORTED;   /* No usable H.264 extension unit. */
+    }
+    *bps = s_h264_committed_bps;
+    return ESP_OK;
 }
 
+/* Auto-Exposure Priority to apply, +1 so that 0 means "leave the camera's default alone".
+ * Unlike the H.264 extension unit this is a Camera Terminal control and takes effect
+ * mid-stream, so it is applied immediately AND re-applied at every stream start - the
+ * restart the bitrate actuator performs would otherwise silently revert it. */
+static uint8_t s_ae_priority_plus_one;
+
+esp_err_t esp_video_uvc_set_ae_priority(uint8_t priority, uint8_t *committed)
+{
+    if (priority > 1) {
+        return ESP_ERR_INVALID_ARG;
+    }
+    s_ae_priority_plus_one = (uint8_t) (priority + 1);
+    if (s_active_stream_hdl == NULL) {
+        /* Recorded for the next stream start; nothing to talk to yet. */
+        return ESP_ERR_INVALID_STATE;
+    }
+    return uvc_host_stream_set_ae_priority(s_active_stream_hdl, priority, committed);
+}
+
+esp_err_t esp_video_uvc_set_h264_frame_interval(uint32_t interval_100ns)
+{
+    /* No I/O and no stream-handle check: recorded here and applied by whichever of
+     * the two actuation paths runs next. */
+    s_h264_pin_frame_interval = interval_100ns;
+    return ESP_OK;
+}
+
+esp_err_t esp_video_uvc_set_h264_start_bitrate(uint32_t ref_bitrate_bps)
+{
+    /* Deliberately no stream handle check and no I/O: this only records what the
+     * next stream start should ask for. Setting it while a stream is running is
+     * the normal case - the caller stops and restarts the stream to apply it. */
+    s_h264_start_bps_override = ref_bitrate_bps;
+    return ESP_OK;
+}
+
+esp_err_t esp_video_uvc_set_h264_bitrate(uint32_t bitrate_bps, uint32_t *committed_bps)
+{
+    if (s_active_stream_hdl == NULL) {
+        return ESP_ERR_INVALID_STATE;
+    }
+    if (s_h264_committed_bps == 0) {
+        return ESP_ERR_NOT_SUPPORTED;
+    }
+    /* iframe_period_ms = 0 leaves the key-frame period alone, so the short period
+     * committed at stream start survives every later bitrate change. The frame-interval
+     * pin is re-asserted, because it decides how this new bitrate is spent. */
+    return uvc_host_stream_h264_set_rate(s_active_stream_hdl, bitrate_bps, 0,
+                                         s_h264_pin_frame_interval, committed_bps);
+}
+
