+    /* Submit, and let USBH's asynchronous EP0 recovery finish before giving up.
+     *
+     * Both failure modes leave EP0 halted and USBH clears it itself - ep0_pipe_callback()
+     * queues DEV_ACTION_EP0_DEQUEUE | DEV_ACTION_EP0_CLEAR on a STALL and adds
+     * DEV_ACTION_EP0_FLUSH on a transaction error - but it does that on the USB host library
+     * task, not inline. Until that task runs, every usb_host_transfer_submit_control()
+     * returns ESP_ERR_INVALID_STATE against the halted pipe.
+     *
+     * Resubmitting immediately therefore cannot work, and one failed transfer used to kill
+     * the whole session: a single "Dev 1 EP 0 Error" on the first request after a soft reset
+     * was followed by ESP_ERR_INVALID_STATE on every later one, all the way down to
+     * "Failed to open UVC stream". So yield between attempts, and treat a submit that reports
+     * the pipe still halted as a reason to wait rather than to fail.
+     *
+     * There is deliberately no usb_host_endpoint_clear(dev_hdl, 0) here. EP0 is not a
+     * claimable endpoint, so that call could only ever return ESP_ERR_INVALID_ARG - it
+     * printed "Get EP handle error" and "could not clear EP0 halt" beside every STALL while
+     * doing nothing. USBH owns the default pipe and recovers it on its own. */
+    for (int attempt = 0; ; attempt++) {
+        const esp_err_t sub = usb_host_transfer_submit_control(p_uvc_host_driver->usb_client_hdl,
+                                                              p_uvc_host_driver->ctrl_transfer);
